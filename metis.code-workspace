{
  "folders": [
    {
      "name": "api-dashboard",
      "path": "api-dashboard",
      "gitRemote": "git@gitlab.com:GroupeAdnenis/metis-connect/api-dashboard",
    },
    {
      "name": "front-dashboard",
      "path": "front-dashboard",
      "gitRemote": "git@gitlab.com:GroupeAdnenis/metis-connect/front-dashboard",
    },
    {
      "name": "metis",
      "path": ".",
    }
  ],
  "settings": {
    "files.exclude": {
      "api-car": true,
      "api-aerial": true,
      "api-dashboard": true,
      "api-hotel": true,
      "api-rail": true,
      "front-dashboard": true,
      "front-reservation": true,
    },
    "editor.formatOnSave": false,
    "scm.defaultViewMode": "tree",
    "scm.alwaysShowRepositories": true,
    "terminal.integrated.automationProfile.windows": {
      "path": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
      ]
    },
    "git.autoRepositoryDetection": true,
    "git.repositoryScanIgnoredFolders": [
      "api-car",
      "api-aerial",
      "api-hotel",
      "api-rail",
      "front-reservation",
    ],
    "git.ignoredRepositories": [],
    "scm.repositories.selectionMode": "multiple",
    "scm.repositories.explorer": true,
    "scm.repositories.visible": 5,
    "scm.repositories.sortOrder": "name",
  },
  "launch": {
    "configurations": [
      {
        "type": "node",
        "request": "launch",
        "name": "Debug: api-aerial (npm)",
        "cwd": "${workspaceFolder:metis}/api-aerial/src",
        "runtimeExecutable": "npm",
        "runtimeArgs": [
          "run",
          "dev",
        ],
        "console": "integratedTerminal",
      },
      {
        "type": "node",
        "request": "launch",
        "name": "Debug: api-dashboard (npm)",
        "cwd": "${workspaceFolder:metis}/api-dashboard/src",
        "runtimeExecutable": "npm",
        "runtimeArgs": [
          "run",
          "dev",
        ],
        "console": "integratedTerminal",
      },
      {
        "type": "node",
        "request": "launch",
        "name": "server: nuxt (front-reservation)",
        "outputCapture": "std",
        "cwd": "${workspaceFolder:metis}/front-reservation/src",
        "runtimeExecutable": "npm",
        "runtimeArgs": [
          "run",
          "dev",
        ]
      },
      {
        "type": "msedge",
        "request": "launch",
        "name": "Launch Edge (front-reservation)",
        "url": "http://localhost:3000",
        "webRoot": "${workspaceFolder:metis}/front-reservation/src",
      }
    ],
    "compounds": [
      {
        "name": "DEBUG ALL (Api-Aerial + Api-Dashboard + Front-Reservation)",
        "configurations": [
          "Debug: api-aerial (npm)",
          "Debug: api-dashboard (npm)",
          "server: nuxt (front-reservation)",
          "Launch Edge (front-reservation)",
        ],
        "stopAll": true,
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Git: pull from dev",
        "type": "shell",
        "command": "node ${workspaceFolder:metis}/tasks/sync_all.js",
        "options": {
          "cwd": "${workspaceFolder:metis}",
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "shared",
        }
      },
      {
        "label": "Git: Hard Reset",
        "type": "shell",
        "command": "node ${workspaceFolder:metis}/tasks/hard_reset.js ${input:repoName}",
        "options": {
          "cwd": "${workspaceFolder:metis}",
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "shared",
        }
      },
      {
        "label": "Setup Workspace",
        "type": "shell",
        "command": "node ${workspaceFolder:metis}/tasks/setup_workspace.js",
        "options": {
          "cwd": "${workspaceFolder:metis}",
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "shared",
        }
      },
    ],
    "inputs": [
      {
        "id": "repoName",
        "type": "pickString",
        "description": "Select the repository to hard reset to development",
        "options": [
          "api-dashboard",
          "front-dashboard",
        ]
      },
    ]
  },
}
